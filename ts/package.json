{
  "name": "hk-gov-rt-mcp",
  "version": "1.0.0",
  "description": "MCP server wrapping Hong Kong government real-time weather (HKO) and transport (KMB/CTB/MTR/LRT/GMB/TD) open APIs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http --port 8819",
    "smoke": "tsx test/smoke.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
